// The tree lab's forms (docs/TREES.md T4, §5): the Graph form each species
// grows under `rmc_app --tree-lab`, over its plants.ron row. Since TREES T7
// the shipped rows carry these same forms; edit here to try a shape in the
// lab, then copy it to plants.ron. Fields as in plants.ron's Graph form; T8
// owns the numbers. Angles are in steps of 4096 per turn. `mature`: metamers before
// the tree flowers and fruits. `max_height_mm`, `max_reach_mm`: the crown's
// envelope (T8). The crown shape, setpoint, whorl and needle fields: T9.
[
    // Oak: 25 cm internodes, 45° laterals on the golden angle, λ 0.52;
    // a round crown, taller than the birch once grown (12 m cap).
    (species: "oak",
     form: Graph(internode_mm: 250, tip_um: 2500, branch_angle: 512,
         divergence: 1564, lambda: 133, gravitropism: 64, phototropism: 96,
         bud_light: 32, max_shoot: 2, max_metamers: 4000, leaf: 4,
         shed_light: 48, shed_after: 6, leaf_age: 8, mature: 200,
         max_height_mm: 12000, lateral_setpoint: 512, crown_ratio: 220,
         crown_peak: 128, crown_damp: 2, root_cells: 4, bark_min_um: 12000)),
    // Birch: 30 cm, 35°, λ 0.58; a narrow oval.
    (species: "birch",
     form: Graph(internode_mm: 300, tip_um: 1800, branch_angle: 398,
         divergence: 1564, lambda: 148, gravitropism: 32, phototropism: 128,
         bud_light: 24, max_shoot: 3, max_metamers: 2500, leaf: 3,
         shed_light: 40, shed_after: 4, leaf_age: 8, mature: 150,
         max_height_mm: 10000, lateral_setpoint: 455, crown_ratio: 150,
         crown_peak: 110, crown_damp: 2, root_cells: 3, bark_min_um: 8000)),
    // Pine: 35 cm, level laterals in whorls of five, λ 0.5; a cone.
    // Needles stay three years.
    (species: "pine",
     form: Graph(internode_mm: 350, tip_um: 2500, branch_angle: 910,
         divergence: 819, lambda: 128, gravitropism: 96, phototropism: 48,
         bud_light: 24, max_shoot: 1, max_metamers: 3000, leaf: 2,
         shed_light: 32, shed_after: 8, leaf_age: 12, mature: 250,
         max_height_mm: 9000, lateral_setpoint: 1000, crown_ratio: 180,
         crown_peak: 0, crown_damp: 32, whorl: 5, whorl_gap: 2, whorl_mm: 30,
         needles: 4, root_cells: 3, bark_min_um: 12000)),
]
