// Season cycle (SAD-P2 §3, §7). Season n uses row n % len; worldgen uses row 0.
// air_temp: clamp for surface and sky-open air, water and ice, in 0.1 °C.
// rain: per-column amount scaled by the seeded pattern (/256).
(
    substeps: 8,
    seasons: [
        (key: "spring", air_temp: 100, rain: 128),
        (key: "summer", air_temp: 220, rain: 64),
        (key: "autumn", air_temp: 80, rain: 160),
        (key: "winter", air_temp: -80, rain: 48),
    ],
)
