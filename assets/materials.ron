// Phase 1 material table (SAD §6).
// `id` must equal the entry's position; 0 is air. Keys are stable across versions.
// Worldgen and tools filter on `tags` and `phase`, never on ids or keys.
// Changing any field changes the table hash, which Hello and the save header carry.
// Heat (SAD-P2 §7.1): surface materials (soil, air) conductivity 64 and capacity 8,
// so 1.6 °C differences move heat; rock 16 and 32, so deep rock stays quiet.
[
    (id: 0, key: "air", phase: Air, tags: [],
     hardness: 0, diggable: false, yield_count: 0, color: (0, 0, 0, 0), emissive: 0.0, conductivity: 64, heat_capacity: 8),

    (id: 1, key: "topsoil", phase: Solid, tags: ["soil"],
     hardness: 10, diggable: true, yield_count: 1, color: (86, 125, 54, 255), emissive: 0.0, conductivity: 64, heat_capacity: 8),
    (id: 2, key: "dirt", phase: Solid, tags: ["soil"],
     hardness: 15, diggable: true, yield_count: 1, color: (121, 85, 58, 255), emissive: 0.0, conductivity: 64, heat_capacity: 8),
    (id: 3, key: "clay", phase: Solid, tags: ["soil"],
     hardness: 20, diggable: true, yield_count: 1, color: (166, 112, 82, 255), emissive: 0.0, conductivity: 64, heat_capacity: 8),

    (id: 4, key: "stone", phase: Solid, tags: ["stone"],
     hardness: 30, diggable: true, yield_count: 1, color: (128, 128, 128, 255), emissive: 0.0, conductivity: 16, heat_capacity: 32),
    (id: 5, key: "granite", phase: Solid, tags: ["stone"],
     hardness: 45, diggable: true, yield_count: 1, color: (156, 134, 126, 255), emissive: 0.0, conductivity: 16, heat_capacity: 32),
    // Basalt (SAD-P2 §5) holds calcium (as lime), iron and phosphorus. It
    // does not weather, so the composition stays locked in.
    (id: 6, key: "basalt", phase: Solid, tags: ["stone"],
     hardness: 60, diggable: true, yield_count: 1, color: (62, 62, 70, 255), emissive: 0.0, conductivity: 16, heat_capacity: 32,
     composition: [("lime", 40), ("fe", 40), ("p", 20)]),

    (id: 7, key: "coal_seam", phase: Solid, tags: ["ore"],
     hardness: 30, diggable: true, yield_count: 1, color: (34, 32, 32, 255), emissive: 0.0,
     emits: [("firedamp", 2)]),
    // Phase 2 (SAD-P2 §5): copper_ore became sulfide_ore. Breaking it
    // yields crushed_sulfide, which weathers; the ore itself does not. Not
    // tagged stone, so ores and crystals never overwrite it (Phase 1 rule).
    (id: 8, key: "sulfide_ore", phase: Solid, tags: ["ore", "sulfide"],
     hardness: 40, diggable: true, yield_count: 1, color: (184, 115, 51, 255), emissive: 0.0,
     composition: [("cu", 60), ("fe", 40), ("s", 80)], yield_material: Some("crushed_sulfide")),
    (id: 9, key: "iron_ore", phase: Solid, tags: ["ore"],
     hardness: 50, diggable: true, yield_count: 1, color: (150, 98, 82, 255), emissive: 0.0),

    (id: 10, key: "glowcrystal", phase: Solid, tags: ["crystal"],
     hardness: 20, diggable: true, yield_count: 1, color: (110, 220, 255, 255), emissive: 2.0),

    (id: 11, key: "bedrock", phase: Solid, tags: [],
     hardness: 65535, diggable: false, yield_count: 0, color: (24, 22, 28, 255), emissive: 0.0),

    (id: 12, key: "brass_plate", phase: Solid, tags: ["placeable"],
     hardness: 40, diggable: true, yield_count: 1, color: (201, 160, 72, 255), emissive: 0.0),

    // Phase 2 (SAD-P2 §5). Water: a liquid whose `moisture` layer is its fill
    // (0..255); the pickaxe empties it and yields nothing. Alpha is for the
    // liquid pass (F127).
    (id: 13, key: "water", phase: Liquid, tags: [],
     hardness: 0, diggable: true, yield_count: 0, color: (40, 90, 200, 160), emissive: 0.0,
     conductivity: 64, heat_capacity: 8, light_attenuation: Some(32)),
    // Ice: frozen water (transitions.ron); its `moisture` layer keeps the fill
    // it froze with. A solid, so it is meshed and walked on; digging it leaves
    // the fill as a puddle and yields nothing. Light passes through it.
    (id: 14, key: "ice", phase: Solid, tags: [],
     hardness: 10, diggable: true, yield_count: 0, color: (196, 226, 242, 255), emissive: 0.0,
     conductivity: 64, heat_capacity: 8, light_attenuation: Some(0)),

    // Limestone (SAD-P2 §5, §8): the band between stone and granite. Porous,
    // so acid water seeps in and dissolve_carbonate fires there; it weathers
    // slowly, releases lime, and leaves its residue, clay (§7.5).
    (id: 15, key: "limestone", phase: Solid, tags: ["stone", "carbonate", "porous"],
     hardness: 25, diggable: true, yield_count: 1, color: (196, 188, 160, 255), emissive: 0.0,
     conductivity: 16, heat_capacity: 32, permeability: 32, field_capacity: 24,
     weathering_rate: 2, weathers_to: Some("clay"), composition: [("lime", 120)]),
    // Crushed sulfide (SAD-P2 §5): what sulfide_ore yields. Placeable tailings
    // that hold water and weather fast, releasing the ore's composition.
    (id: 16, key: "crushed_sulfide", phase: Solid, tags: ["sulfide", "porous", "placeable"],
     hardness: 10, diggable: true, yield_count: 1, color: (122, 112, 64, 255), emissive: 0.0,
     conductivity: 64, heat_capacity: 8, permeability: 96, field_capacity: 48,
     weathering_rate: 48, composition: [("cu", 60), ("fe", 40), ("s", 80)]),
    // Yield materials (SAD-P2 §5, §7.8): one per substance with a
    // yield_material in substances.ron, holding only that substance.
    (id: 17, key: "copper_dust", phase: Solid, tags: ["placeable"],
     hardness: 5, diggable: true, yield_count: 1, color: (196, 110, 60, 255), emissive: 0.0,
     composition: [("cu", 255)]),
    (id: 18, key: "iron_dust", phase: Solid, tags: ["placeable"],
     hardness: 5, diggable: true, yield_count: 1, color: (140, 82, 64, 255), emissive: 0.0,
     composition: [("fe", 255)]),
    (id: 19, key: "salt_dust", phase: Solid, tags: ["placeable"],
     hardness: 5, diggable: true, yield_count: 1, color: (232, 230, 220, 255), emissive: 0.0,
     composition: [("salt", 255)]),

    // Magma (SAD-P2 §5, §7.3): a slow liquid (it tries to move on one flow
    // iteration in viscosity + 1). Opaque and full-cell in the normal mesh
    // pass (alpha 255, SAD-P2 §10), glowing in its own color. Heat capacity
    // 64, not §5's 32: at 32 the tip cells of every worldgen chamber cool
    // below 900.0 °C within 20 sub-steps (PROGRESS.md, F131).
    (id: 20, key: "magma", phase: Liquid, tags: [],
     hardness: 0, diggable: false, yield_count: 0, color: (255, 96, 16, 255), emissive: 2.0,
     viscosity: 3, conductivity: 64, heat_capacity: 64),
    // The core of a magma chamber: a fixed heat source, never dug. Not
    // tagged stone, so it never melts.
    (id: 21, key: "magma_source", phase: Solid, tags: [],
     hardness: 65535, diggable: false, yield_count: 0, color: (255, 150, 40, 255), emissive: 3.0,
     heat_source: Some(13000)),
    // Obsidian: magma quenched by water (contact boiling, §7.3 B7). Glassy
    // black with a violet cast, harder than basalt.
    (id: 22, key: "obsidian", phase: Solid, tags: [],
     hardness: 70, diggable: true, yield_count: 1, color: (30, 20, 40, 255), emissive: 0.0),

    // Crusts (SAD-P2 §5, §7.6): what the ochre and salt_crust reactions
    // coat onto a floor once its iron or salt reaches eco.crust_threshold.
    // Soft and diggable; digging one yields nothing and leaves the coated
    // substance on the cell (§7.0), where water can carry it again.
    (id: 23, key: "ochre_crust", phase: Solid, tags: ["crust", "porous"],
     hardness: 10, diggable: true, yield_count: 0, color: (186, 112, 42, 255), emissive: 0.0,
     composition: [("fe", 60)]),
    (id: 24, key: "salt_crust", phase: Solid, tags: ["crust"],
     hardness: 5, diggable: true, yield_count: 0, color: (238, 234, 222, 255), emissive: 0.0,
     composition: [("salt", 80)]),
]
