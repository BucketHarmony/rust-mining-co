// Phase 1 material table (SAD §6).
// `id` must equal the entry's position; 0 is air. Keys are stable across versions.
// Worldgen and tools filter on `tags` and `phase`, never on ids or keys.
// Changing any field changes the table hash, which Hello and the save header carry.
// Heat (SAD-P2 §7.1): surface materials (soil, air) conductivity 64 and capacity 8,
// so 1.6 °C differences move heat; rock 16 and 32, so deep rock stays quiet.
[
    (id: 0, key: "air", phase: Air, tags: [],
     hardness: 0, diggable: false, yield_count: 0, color: (0, 0, 0, 0), emissive: 0.0, conductivity: 64, heat_capacity: 8),

    (id: 1, key: "topsoil", phase: Solid, tags: ["soil"],
     hardness: 10, diggable: true, yield_count: 1, color: (86, 125, 54, 255), emissive: 0.0, conductivity: 64, heat_capacity: 8),
    (id: 2, key: "dirt", phase: Solid, tags: ["soil"],
     hardness: 15, diggable: true, yield_count: 1, color: (121, 85, 58, 255), emissive: 0.0, conductivity: 64, heat_capacity: 8),
    (id: 3, key: "clay", phase: Solid, tags: ["soil"],
     hardness: 20, diggable: true, yield_count: 1, color: (166, 112, 82, 255), emissive: 0.0, conductivity: 64, heat_capacity: 8),

    (id: 4, key: "stone", phase: Solid, tags: ["stone"],
     hardness: 30, diggable: true, yield_count: 1, color: (128, 128, 128, 255), emissive: 0.0, conductivity: 16, heat_capacity: 32),
    (id: 5, key: "granite", phase: Solid, tags: ["stone"],
     hardness: 45, diggable: true, yield_count: 1, color: (156, 134, 126, 255), emissive: 0.0, conductivity: 16, heat_capacity: 32),
    (id: 6, key: "basalt", phase: Solid, tags: ["stone"],
     hardness: 60, diggable: true, yield_count: 1, color: (62, 62, 70, 255), emissive: 0.0, conductivity: 16, heat_capacity: 32),

    (id: 7, key: "coal_seam", phase: Solid, tags: ["ore"],
     hardness: 30, diggable: true, yield_count: 1, color: (34, 32, 32, 255), emissive: 0.0),
    (id: 8, key: "copper_ore", phase: Solid, tags: ["ore"],
     hardness: 40, diggable: true, yield_count: 1, color: (184, 115, 51, 255), emissive: 0.0),
    (id: 9, key: "iron_ore", phase: Solid, tags: ["ore"],
     hardness: 50, diggable: true, yield_count: 1, color: (150, 98, 82, 255), emissive: 0.0),

    (id: 10, key: "glowcrystal", phase: Solid, tags: ["crystal"],
     hardness: 20, diggable: true, yield_count: 1, color: (110, 220, 255, 255), emissive: 2.0),

    (id: 11, key: "bedrock", phase: Solid, tags: [],
     hardness: 65535, diggable: false, yield_count: 0, color: (24, 22, 28, 255), emissive: 0.0),

    (id: 12, key: "brass_plate", phase: Solid, tags: ["placeable"],
     hardness: 40, diggable: true, yield_count: 1, color: (201, 160, 72, 255), emissive: 0.0),

    // Phase 2 (SAD-P2 §5). Water: a liquid whose `moisture` layer is its fill
    // (0..255); the pickaxe empties it and yields nothing. Alpha is for the
    // liquid pass (F127).
    (id: 13, key: "water", phase: Liquid, tags: [],
     hardness: 0, diggable: true, yield_count: 0, color: (40, 90, 200, 160), emissive: 0.0,
     conductivity: 64, heat_capacity: 8, light_attenuation: Some(32)),
    // Ice: frozen water (transitions.ron); its `moisture` layer keeps the fill
    // it froze with. A solid, so it is meshed and walked on; digging it leaves
    // the fill as a puddle and yields nothing. Light passes through it.
    (id: 14, key: "ice", phase: Solid, tags: [],
     hardness: 10, diggable: true, yield_count: 0, color: (196, 226, 242, 255), emissive: 0.0,
     conductivity: 64, heat_capacity: 8, light_attenuation: Some(0)),
]
