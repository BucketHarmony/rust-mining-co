// World generation parameters (SAD §9).
// Heights and depths are in cells (0.5 m). Noise frequencies are per meter,
// because noise is sampled at world meters. Materials are named by key and
// checked against the material table: soil layers need the "soil" tag,
// strata the "stone" tag.
// Changing any field changes the params hash, which Welcome and the save
// header carry.
(
    surface: (
        // Mean surface: the topmost solid cell sits at base_height + offset,
        // offset in [-amplitude, amplitude].
        base_height: 96,
        amplitude: 10,
        noise: (frequency: 0.02, octaves: 4),
    ),
    // Top down from the surface. Each column draws its thickness in
    // [min_cells, max_cells] from the layer's own noise.
    soil: [
        (material: "topsoil", min_cells: 1, max_cells: 2,
         noise: (frequency: 0.15, octaves: 1)),
        (material: "dirt", min_cells: 3, max_cells: 5,
         noise: (frequency: 0.08, octaves: 2)),
    ],
    // Below the soil, by depth under the surface (0 = the top solid cell).
    // A stratum reaches down to until_depth, moved by up to
    // boundary_amplitude cells of noise; the last one has no limit.
    strata: (
        boundary_amplitude: 4,
        boundary_noise: (frequency: 0.04, octaves: 2),
        layers: [
            (material: "stone", until_depth: Some(24)),
            (material: "granite", until_depth: Some(56)),
            (material: "basalt", until_depth: None),
        ],
    ),
)
