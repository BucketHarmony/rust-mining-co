// World generation parameters (SAD §9).
// Heights and depths are in cells (0.5 m). Noise frequencies are per meter,
// because noise is sampled at world meters. Materials are named by key and
// checked against the material table: soil layers need the "soil" tag,
// strata the "stone" tag.
// Changing any field changes the params hash, which Welcome and the save
// header carry.
(
    // World extent in cells, both corners included (SAD §5: 256 × 128 × 256
    // cells, 8 × 4 × 8 chunks). The bedrock shell lies inside it.
    bounds: (min: (0, 0, 0), max: (255, 127, 255)),
    surface: (
        // Mean surface: the topmost solid cell sits at base_height + offset,
        // offset in [-amplitude, amplitude].
        base_height: 96,
        amplitude: 10,
        noise: (frequency: 0.02, octaves: 4),
    ),
    // Top down from the surface. Each column draws its thickness in
    // [min_cells, max_cells] from the layer's own noise.
    soil: [
        (material: "topsoil", min_cells: 1, max_cells: 2,
         noise: (frequency: 0.15, octaves: 1)),
        (material: "dirt", min_cells: 3, max_cells: 5,
         noise: (frequency: 0.08, octaves: 2)),
    ],
    // Below the soil, by depth under the surface (0 = the top solid cell).
    // A stratum reaches down to until_depth, moved by up to
    // boundary_amplitude cells of noise; the last one has no limit.
    strata: (
        boundary_amplitude: 4,
        boundary_noise: (frequency: 0.04, octaves: 2),
        layers: [
            (material: "stone", until_depth: Some(24)),
            (material: "granite", until_depth: Some(56)),
            (material: "basalt", until_depth: None),
        ],
    ),
    // Carved to air after the strata, in cells deeper than surface_margin
    // under the surface cell. Noise values are in about [-1, 1].
    caves: (
        surface_margin: 4,
        // Blob caves where 3D noise exceeds the threshold (above 1: none).
        blob: (threshold: 0.55, noise: (frequency: 0.05, octaves: 2)),
        // Worm tunnels where both 3D noises lie within ±radius of zero
        // (0: none). Each is near zero on a sheet; two sheets meet in a curve.
        worm: (
            radius: 0.07,
            a: (frequency: 0.03, octaves: 1),
            b: (frequency: 0.035, octaves: 1),
        ),
    ),
    // Replace cells tagged "stone" (never soil, air or another ore) where
    // the ore's 3D noise exceeds its threshold, at depths
    // min_depth..=max_depth under the surface cell. Where two ores overlap,
    // the earlier one wins. Materials need the "ore" tag.
    ores: [
        (material: "coal_seam", min_depth: 6, max_depth: 40,
         threshold: 0.7, noise: (frequency: 0.12, octaves: 1)),
        (material: "copper_ore", min_depth: 16, max_depth: 64,
         threshold: 0.75, noise: (frequency: 0.15, octaves: 1)),
        (material: "iron_ore", min_depth: 36, max_depth: 84,
         threshold: 0.75, noise: (frequency: 0.15, octaves: 1)),
    ],
    // On cells tagged "stone" (after ores) that share a face with air,
    // mostly cave walls. A hash of the cell and the seed picks
    // chance_per_million of them in a million. The material needs the
    // "crystal" tag.
    crystals: (material: "glowcrystal", chance_per_million: 30000),
    // Last word over every other step, inside the bounds: the bottom
    // floor_cells layers and the wall_cells columns at each x and z edge,
    // full height. The material must be solid and not diggable.
    bedrock: (material: "bedrock", floor_cells: 2, wall_cells: 1),
    // SAD-P2 §8: below each column's water_table_y = level + offset (offset
    // in [-amplitude, amplitude] from the noise), porous solids start at
    // their field_capacity and caves are flooded (fill 255). Applied last,
    // after the shell. Amplitude 0 keeps the table level, so the flooded
    // caves start at rest. The level sits 22..42 cells under the surface,
    // where the initial temperature is above freezing; fit_to scales it with
    // the world's height.
    water_table: Some((
        level: 64,
        amplitude: 0,
        noise: (frequency: 0.02, octaves: 2),
    )),
    // SAD-P2 §8: count_min..=count_max magma chambers, placed by a hash of
    // the seed. Each is a ball of radius_min..=radius_max cells whose edge
    // moves by up to amplitude cells of 3D noise, around a core of the cells
    // within core_radius of its center. Every chamber cell lies below
    // chamber_max_y and more than shell_clearance cells from the bedrock
    // shell on each axis. The materials are the eco roles magma and
    // magma_source; without them there are no chambers. chamber_max_y sits
    // below the water table, so a chamber meets only flooded caves; fit_to
    // scales it with the world's height (28 in a 64-high world, which still
    // fits a chamber of the largest radius).
    magma_chambers: Some((
        count_min: 1,
        count_max: 3,
        chamber_max_y: 56,
        radius_min: 3,
        radius_max: 5,
        amplitude: 1,
        noise: (frequency: 0.3, octaves: 1),
        core_radius: 1,
        shell_clearance: 8,
    )),
)
