// Items that are not materials, the bag and the starting kit
// (docs/ITEMS.md). Loaded by rmc_world::items::ItemTable.
//
// An item's id is its row index, so add rows at the end. Host and client
// load the same file.
//
// bag:            hotbar slots (1 to 9, one per number key) and pack slots.
// material_stack: the largest stack of a mined material.
// items:          key (stable), name (shown), tags (code filters on these),
//                 stack (largest stack), tool (the tools.ron profile a tool
//                 swings with), slot (Head, Body, Legs, Feet or Hands: where
//                 a wearable goes).
// start:          what a new player gets, in order. Wearables are put on
//                 when their slot is free; the rest go in the hotbar first.
(
    bag: (hotbar: 9, pack: 27),
    material_stack: 999,
    items: [
        (key: "pickaxe", name: "Pickaxe", tags: ["tool"], stack: 1, tool: Some("pickaxe")),
        (key: "work_cap", name: "Work cap", tags: ["clothing"], stack: 1, slot: Some(Head)),
        (key: "work_shirt", name: "Work shirt", tags: ["clothing"], stack: 1, slot: Some(Body)),
        (key: "work_trousers", name: "Work trousers", tags: ["clothing"], stack: 1, slot: Some(Legs)),
        (key: "work_boots", name: "Work boots", tags: ["clothing"], stack: 1, slot: Some(Feet)),
        (key: "work_gloves", name: "Work gloves", tags: ["clothing"], stack: 1, slot: Some(Hands)),
        (key: "hard_hat", name: "Hard hat", tags: ["armor"], stack: 1, slot: Some(Head)),
    ],
    start: [
        ("pickaxe", 1),
        ("work_cap", 1),
        ("work_shirt", 1),
        ("work_trousers", 1),
        ("work_boots", 1),
        ("work_gloves", 1),
        ("hard_hat", 1),
    ],
)
