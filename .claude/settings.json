{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(~/.ssh/**)",
      "Read(./.env)",
      "Edit(./features.json)",
      "Write(./features.json)",
      "Edit(./docs/SAD.md)",
      "Write(./docs/SAD.md)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./PROMPT.md)",
      "Write(./PROMPT.md)"
    ],
    "allow": [
      "Bash(cargo *)",
      "Bash(git *)",
      "Bash(gh run *)",
      "Bash(scripts/*)",
      "Bash(./scripts/*)",
      "Bash(jq *)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:bevy.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  },
  "env": {
    "CARGO_TERM_COLOR": "never",
    "RUST_BACKTRACE": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git commit *)", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-commit.sh", "timeout": 900, "onFailure": "block", "statusMessage": "Running commit gate (fmt, clippy, tests, features)" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cargo-check.sh", "timeout": 300, "statusMessage": "clippy on touched crate" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-guard.sh", "timeout": 900 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "cd \"${CLAUDE_PROJECT_DIR}\" && echo '--- PROGRESS.md (tail) ---' && tail -n 60 PROGRESS.md && echo '--- git log ---' && git log --oneline -10 && echo '--- status ---' && git status --short" }
        ]
      }
    ]
  }
}
